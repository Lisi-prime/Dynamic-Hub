--[[
    Dynamic Hub - Universal Loader
    by Lisi
]]

local StarterGui = game:GetService("StarterGui")
local PlaceId = game.PlaceId
local GameId = game.GameId

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "Dynamic Hub",
            Text = text,
            Duration = duration or 4
        })
    end)
end

local isMM2 = (PlaceId == 142823291) or (PlaceId == 335132778) or (GameId == 66654135)

if isMM2 then
    notify("Dynamic Hub", "Murder Mystery 2 обнаружен! Загрузка...", 3)
    
    local coreLoaded, coreErr = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/refs/heads/main/Dynamic_hub"))()
    end)
    if not coreLoaded then
        warn("[Dynamic Hub] Ошибка загрузки Core:", coreErr)
        notify("Dynamic Hub", "Ошибка загрузки Core!", 5)
        return
    end

    local guiLoaded, guiErr = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/refs/heads/main/Dynamic_gui"))()
    end)
    if not guiLoaded then
        warn("[Dynamic Hub] Ошибка загрузки GUI:", guiErr)
        notify("Dynamic Hub", "Ошибка загрузки GUI!", 5)
        return
    end

    notify("Dynamic Hub", "Успешно запущен!", 3)

else
    notify("Dynamic Hub", "Игра не поддерживается! (ID: " .. tostring(PlaceId) .. ")", 5)
    warn("[Dynamic Hub] Игра не поддерживается. PlaceId: " .. tostring(PlaceId) .. ", GameId: " .. tostring(GameId))
end
