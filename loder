--[[
    Dynamic Hub - Universal Loader
    by Lisi
]]

local PlaceId = game.PlaceId
local GameId = game.GameId

if PlaceId == 142823291 or PlaceId == 335132778 or GameId == 66654135 then
    local function get(url)
        local s = nil
        for i = 1, 3 do
            local ok, res = pcall(game.HttpGet, game, url)
            if ok and type(res) == "string" and #res > 500 then
                s = res
                break
            end
            task.wait(0.15)
        end
        return s
    end

    local coreRaw = get("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/main/Dynamic_hub")
        or get("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/refs/heads/main/Dynamic_hub")
    
    local Hub = nil
    if coreRaw then
        local fn = loadstring(coreRaw)
        if fn then
            local ok, res = pcall(fn)
            if ok and type(res) == "table" then
                Hub = res
            end
        end
    end

    Hub = Hub or _G.DynamicHub or (getgenv and getgenv().DynamicHub)
    if Hub then
        _G.DynamicHub = Hub
        if getgenv then pcall(function() getgenv().DynamicHub = Hub end) end
        pcall(function() shared.DynamicHub = Hub end)
    end

    task.wait(0.1)

    local guiRaw = get("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/main/Dynamic_gui")
        or get("https://raw.githubusercontent.com/Lisi-prime/Dynamic-Hub/refs/heads/main/Dynamic_gui")
    
    if guiRaw then
        local fn = loadstring(guiRaw)
        if fn then
            pcall(fn, Hub)
        end
    end
end
